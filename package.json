{
  "name": "smart-srrt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:ui-assets && npm run build:gas-multifile",
    "build:check": "npm run check:ui-assets && npm run check:gas-multifile",
    "check:contracts": "node --test tests/g30-release-parity.test.mjs tests/g34-multifile-parity.test.mjs tests/ux-r2-03-native-dashboard.test.mjs tests/ux-r2-m01-final-stabilization.test.mjs tests/gs-s1-operator-rpc-boundary.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "release:preflight": "node tools/p6-release-preflight.mjs",
    "build:gas-multifile": "node tools/build-apps-script-multifile.mjs --write",
    "check:gas-multifile": "node tools/build-apps-script-multifile.mjs --check",
    "build:ui-assets": "node tools/build-ui-assets.mjs --write",
    "check:ui-assets": "node tools/build-ui-assets.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
